
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "white",
      "2": "white"
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    {
      "type": "custom",
      "key": " ",
      "format": "┌──────── Hardware Flex ──────────┐",
      "outputColor": "white"
    },
    {
      "type": "cpu",
      "key": "│ CPU",
      "keyColor": "white",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│ GPU",
      "keyColor": "white",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│ Memory",
      "keyColor": "white",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "│ Disk",
      "keyColor": "white",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "display",
      "key": "│ Display",
      "keyColor": "white",
      "format": "{width}x{height}, {refresh-rate} Hz"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "├──────── Software Flex ──────────┤",
      "outputColor": "white"
    },
    {
      "type": "os",
      "key": "│ OS",
      "keyColor": "white",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "│ Kernel",
      "keyColor": "white",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "│ WM",
      "keyColor": "white",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "│ Terminal",
      "keyColor": "white",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "└─────────────────────────────────┘",
      "outputColor": "white"
    }
  ]
}

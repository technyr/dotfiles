general {
    colors = true
    interval = 2
    color_good = "#d0d0d0"
    color_degraded = "#e5c07b"
    color_bad = "#ff5555"
}

order += "cpu_usage"
order += "memory"
order += "disk /"
order += "volume master"
order += "tztime local"

cpu_usage {
    format = " %usage"
}

memory {
    format = " %used"
    threshold_degraded = "20%"
    format_degraded = " LOW %free"
}

disk "/" {
    format = " %avail"
}

volume master {
    format = " %volume"
    format_muted = " muted"
}

tztime local {
    format = "%a %d %b  %H:%M"
}
